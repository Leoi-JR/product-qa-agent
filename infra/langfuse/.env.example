# Langfuse 环境变量配置
# 用法：cp .env.example .env，然后填写真实值
#
# ⚠️ 所有标 # CHANGEME 的字段必须改成随机值
# 一键生成所有密钥：
#   for k in NEXTAUTH_SECRET SALT ENCRYPTION_KEY; do
#     echo "$k=$(openssl rand -hex 32)"
#   done
#   echo "POSTGRES_PASSWORD=$(openssl rand -base64 24 | tr -d '/+=' | head -c 32)"
#   echo "CLICKHOUSE_PASSWORD=$(openssl rand -base64 24 | tr -d '/+=' | head -c 32)"
#   echo "REDIS_AUTH=$(openssl rand -base64 24 | tr -d '/+=' | head -c 32)"
#   echo "MINIO_ROOT_PASSWORD=$(openssl rand -base64 24 | tr -d '/+=' | head -c 16)"

# ════════════════════════════════════════════════════
# 端口与访问入口
# ════════════════════════════════════════════════════

# 宿主机端口（避开 3000，前端开发常用）
# 如 3001 也被占，改成 3002 / 3005 等
LANGFUSE_PORT=3001

# 浏览器访问 Langfuse 的入口 URL
# 本机访问保持默认；如需从其他机器访问，改成实际 IP
# 例：NEXTAUTH_URL=http://192.168.1.100:3001
NEXTAUTH_URL=http://localhost:3001

# ════════════════════════════════════════════════════
# Postgres 元数据库
# ════════════════════════════════════════════════════

POSTGRES_USER=langfuse
POSTGRES_PASSWORD=replace-with-random-string  # CHANGEME
POSTGRES_DB=langfuse

# ════════════════════════════════════════════════════
# ClickHouse trace 库
# ⚠️ CLICKHOUSE_DB 固定为 default，不要改（Langfuse migration 硬编码）
# ════════════════════════════════════════════════════

CLICKHOUSE_USER=langfuse
CLICKHOUSE_PASSWORD=replace-with-random-string  # CHANGEME
# 注意：纯字母数字，避免 URL 编码问题

# ════════════════════════════════════════════════════
# Redis（worker 用 BullMQ 处理队列）
# ════════════════════════════════════════════════════

REDIS_AUTH=replace-with-random-string  # CHANGEME

# ════════════════════════════════════════════════════
# MinIO（S3 兼容对象存储）
# ⚠️ MINIO_ROOT_PASSWORD 至少 8 位
# ════════════════════════════════════════════════════

MINIO_ROOT_USER=langfuse
MINIO_ROOT_PASSWORD=replace-with-random-string  # CHANGEME

# ════════════════════════════════════════════════════
# Langfuse 加密密钥
# 三个都是必填，用 openssl rand -hex 32 生成
# ════════════════════════════════════════════════════

# NextAuth.js 用于签 JWT 的密钥
NEXTAUTH_SECRET=replace-with-openssl-rand-hex-32  # CHANGEME

# 密码哈希盐值
SALT=replace-with-openssl-rand-hex-32  # CHANGEME

# 加密敏感字段（API key 等）的对称密钥
# 32 字节十六进制（64 个字符），生成：openssl rand -hex 32
ENCRYPTION_KEY=replace-with-openssl-rand-hex-32  # CHANGEME
