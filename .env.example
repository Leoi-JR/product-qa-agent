# 百度千帆 API 配置
# 控制台地址: https://console.bce.baidu.com/qianfan/
# 获取 API Key 后填入下方（去掉 .example 后缀重命名为 .env）
QIANFAN_API_KEY=your_key_here
QIANFAN_BASE_URL=https://qianfan.baidubce.com/v2

# 生产链路模型（query_parser + answer_generator，不用 think 版以保证响应速度）
QIANFAN_MODEL=deepseek-v3.2

# ── Benchmark 离线脚本限流配置（build_benchmark_dataset.py）──
# deepseek-v3.2（非 think）：5000 RPM 上限，默认 2000 留 60% 余量
LLM_RPM=2000
LLM_CONCURRENCY=32
# 如需切换到 think 模型（60 RPM），取消注释以下三行并注释上方两行：
# QIANFAN_MODEL=deepseek-v3.2-think
# LLM_RPM=54
# LLM_CONCURRENCY=8
# LLM_THINKING=true

# Langfuse 可观测（可选）
# LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
# LANGFUSE_SECRET_KEY=your_langfuse_secret_key
# LANGFUSE_HOST=https://cloud.langfuse.com
